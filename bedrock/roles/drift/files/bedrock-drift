#!/usr/bin/env python3
"""Bedrock drift check: run the playbook in check mode and tell the Change Timeline what differs.

Run nightly by bedrock-drift.timer (roles/drift) on the control node, for every server in the inventory
(27 Oct: the lab, vm2 and hetops-3). Nothing is changed: --check only. The timeline gets, per server, a count and the
roles, never task names (those stay here, in the journal: journalctl -u bedrock-drift). It is told only when
a server differs, or once when it matches Bedrock again.
"""
import json
import os
import re
import socket
import subprocess
import sys
import urllib.request
from datetime import datetime, timezone
from pathlib import Path

BEDROCK = Path(os.environ.get("BEDROCK_DIR", Path(__file__).resolve().parent))
TOKEN = Path("/etc/bedrock/timeline-token")
STATE = Path.home() / ".local/state/bedrock/hosts"        # one file per server: "clean" or "drift"
LEGACY = Path.home() / ".local/state/bedrock/last"        # before 25 Oct: this server's state, alone


def check():
    env = {**os.environ, "ANSIBLE_STDOUT_CALLBACK": "ansible.posix.json"}
    run = subprocess.run(["ansible-playbook", "site.yml", "--check"], cwd=BEDROCK, env=env,
                         capture_output=True, text=True, timeout=1800)
    try:
        return json.loads(run.stdout), run
    except json.JSONDecodeError:
        return None, run


def handlers(bedrock=BEDROCK):
    """{(role, name)} of every handler. A handler that would run is a consequence of a change, not a change
    (live run, 21 Oct: one hand edit counted twice, the template and Reload SSH)."""
    names = set()
    for f in Path(bedrock).glob("roles/*/handlers/main.yml"):
        for line in f.read_text().splitlines():
            m = re.match(r"^- name: (.+?)\s*$", line)
            if m:
                names.add((f.parent.parent.name, m.group(1).strip("'\"")))
    return names


def per_host(data, skip=frozenset()):
    """{host: (changed, failed)}, tasks as {role, task}; the json callback names tasks 'role : task'. Every
    host in the run's stats is listed, so a clean one is reported clean. An unreachable host is a failure:
    a server the control node cannot reach is not a server that matches. Handlers in skip count when they
    fail, never when they would change."""
    hosts = {h: ([], []) for h in data.get("stats", {})}
    for play in data.get("plays", []):
        for t in play.get("tasks", []):
            name = t.get("task", {}).get("name", "")
            role, _, task = name.partition(" : ") if " : " in name else ("", "", name)
            for host, result in t.get("hosts", {}).items():
                changed, failed = hosts.setdefault(host, ([], []))
                if result.get("unreachable"):
                    failed.append({"role": "bedrock", "task": "the server could not be reached"})
                elif result.get("failed") and not result.get("ignore_errors"):
                    failed.append({"role": role, "task": task})
                elif result.get("changed") and (role, task) not in skip:
                    changed.append({"role": role, "task": task})
    return hosts


def differences(data, skip=frozenset()):
    """(changed, failed) over every host together."""
    changed, failed = [], []
    for c, f in per_host(data, skip).values():
        changed += c
        failed += f
    return changed, failed


def post(body):
    if not TOKEN.exists():
        print("no /etc/bedrock/timeline-token: not reporting (a machine without the lab's timeline)")
        return True
    ip = subprocess.run(["kubectl", "-n", "timeline", "get", "svc", "timeline", "-o", "jsonpath={.spec.clusterIP}"],
                        capture_output=True, text=True, timeout=30).stdout.strip()
    if not re.fullmatch(r"[0-9.]+", ip):
        print(f"timeline service not found ({ip!r}): not reporting")
        return False
    req = urllib.request.Request(f"http://{ip}:8080/ingest/ansible", data=json.dumps(body).encode(), method="POST",
                                 headers={"content-type": "application/json",
                                          "authorization": f"Bearer {TOKEN.read_text().strip()}"})
    with urllib.request.urlopen(req, timeout=10) as res:
        print(f"timeline answered {res.status}")
        return 200 <= res.status < 300


def main():
    data, run = check()
    commit = subprocess.run(["git", "-C", str(BEDROCK), "rev-parse", "--short=12", "HEAD"],
                            capture_output=True, text=True).stdout.strip()
    if data is None:
        results = {socket.gethostname(): ([], [{"role": "bedrock", "task": "the playbook did not run"}])}
        print(run.stderr[-2000:], file=sys.stderr)
    else:
        results = per_host(data, handlers())
    ok = True
    STATE.mkdir(parents=True, exist_ok=True)
    for host, (changed, failed) in sorted(results.items()):
        for kind, tasks in (("FAILED", failed), ("would change", changed)):
            for t in tasks:
                print(f"{host}: {kind}: {t['role']} : {t['task']}")
        now = "drift" if changed or failed else "clean"
        state = STATE / host
        # This server's state from before the fleet (one file) carries over, so a drift seen then still clears.
        if not state.exists() and LEGACY.exists() and host == socket.gethostname():
            state.write_text(LEGACY.read_text())
        last = state.read_text().strip() if state.exists() else "clean"
        print(f"{host}: {len(changed)} changed, {len(failed)} failed, at {commit}; last time: {last}")
        if now == "drift" or last == "drift":
            ok = post({"host": host, "at": datetime.now(timezone.utc).isoformat(timespec="seconds"),
                       "commit": commit, "changed": changed, "failed": failed, "cleared": now == "clean"}) and ok
        state.write_text(now + "\n")
    sys.exit(0 if ok else 1)


if __name__ == "__main__":
    main()
