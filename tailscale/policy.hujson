// The tailnet's access policy (29 Oct). Git is its only source: CI tests it on every pull request and pushes it to
// Tailscale on merge (.github/workflows/tailscale.yml); the admin console's editor is locked to this file.
// Default deny: anything not granted below is refused.
{
	// Only admins can put these tags on a machine, so a login key or a member cannot tag itself into a server's access.
	"tagOwners": {
		"tag:lab": ["autogroup:admin"], // my-workspace: the lab cluster and every HetOps site
		"tag:ops": ["autogroup:admin"], // hetops-3: the ops cluster (Gatus; later ELK)
		"tag:staging": ["autogroup:admin"], // vm2: staging, where changes are tried first
	},

	"grants": [
		// The lab's Alertmanager heartbeat and Uptime Kuma's "Ops watcher" monitor reach Gatus.
		{"src": ["tag:lab"], "dst": ["tag:ops"], "ip": ["tcp:8080"]},
		// The lab's ops-filebeat ships logs to Elasticsearch on hetops-3 (sub-project 2). 9300 (transport) stays closed.
		{"src": ["tag:lab"], "dst": ["tag:ops"], "ip": ["tcp:9200"]},
		// tailscale ping and ordinary ping between the two servers, for troubleshooting.
		{"src": ["tag:lab"], "dst": ["tag:ops"], "ip": ["icmp:*"]},
		{"src": ["tag:ops"], "dst": ["tag:lab"], "ip": ["icmp:*"]},
		// HetOps Control: the center on hetops-3 reads the lab's agent (TLS + bearer token, hostPort on 100.93.151.22).
		{"src": ["tag:ops"], "dst": ["tag:lab"], "ip": ["tcp:7443"]},
		// HetOps Control: the center reads the staging agent (TLS from the ops CA + bearer token, hostPort on vm2's
		// Tailscale address). Staging gets no grant of its own: it is only ever called, and keeps its own resolver.
		{"src": ["tag:ops"], "dst": ["tag:staging"], "ip": ["tcp:7443"]},
		{"src": ["tag:ops"], "dst": ["tag:staging"], "ip": ["icmp:*"]},
		{"src": ["tag:staging"], "dst": ["tag:ops"], "ip": ["icmp:*"]},
		// The owner's own devices (the phones) see Gatus's page, its only way in; nothing else on either server.
		{"src": ["autogroup:member"], "dst": ["tag:ops"], "ip": ["tcp:8080"]},
		// The tailnet's DNS (admin console, DNS: global nameserver) is the lab's AdGuard, so the owner's devices
		// resolve through it. The servers do not: each uses its own resolver (accept-dns off), so hetops-3 still
		// resolves names when the lab is down.
		{"src": ["autogroup:member"], "dst": ["tag:lab"], "ip": ["udp:53", "tcp:53"]},
	],

	// Checked by Tailscale on every test and apply: a change that breaks one of these is refused.
	"tests": [
		{
			"src":    "tag:lab",
			"accept": ["tag:ops:8080", "tag:ops:9200"],
			"deny":   ["tag:ops:22", "tag:ops:6443", "tag:ops:9300"],
		},
		{
			"src":    "tag:ops",
			"accept": ["tag:lab:7443"],
			"deny":   ["tag:lab:22", "tag:lab:6443", "tag:lab:80", "tag:lab:443", "tag:lab:3001"],
		},
		{
			"src":    "hetpatidar09@gmail.com",
			"accept": ["tag:ops:8080", "tag:lab:53"],
			"deny":   ["tag:ops:22", "tag:lab:22", "tag:lab:6443", "tag:lab:3001", "tag:lab:7443"],
		},
		// Staging (vm2): only the center on hetops-3 reaches its agent; staging itself reaches nothing.
		{
			"src":    "tag:ops",
			"accept": ["tag:staging:7443"],
			"deny":   ["tag:staging:22", "tag:staging:6443", "tag:staging:10250"],
		},
		{
			"src":  "tag:staging",
			"deny": ["tag:ops:8080", "tag:ops:9200", "tag:ops:22", "tag:lab:7443", "tag:lab:53", "tag:lab:22"],
		},
		{
			"src":  "tag:lab",
			"deny": ["tag:staging:7443", "tag:staging:22", "tag:staging:6443"],
		},
		{
			"src":  "hetpatidar09@gmail.com",
			"deny": ["tag:staging:7443", "tag:staging:22", "tag:staging:6443"],
		},
	],
}
